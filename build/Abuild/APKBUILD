# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=qt6-tools
pkgver=6.10.0
pkgrel=0
_llvmver=21
pkgdesc="A cross-platform application and UI framework (Development Tools, QtHelp)"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends="$pkgname-libs=$pkgver-r$pkgrel
    clang-libs
    llvm-libs
    qt6-declarative
    "
depends_dev="$pkgname=$pkgver-r$pkgrel
    qt6-declarative-dev
    qt6-declarative-private-dev
    vulkan-headers
    curl-dev
    "
makedepends="$depends_dev
    clang-dev~$_llvmver
    cmake
    llvm-dev~$_llvmver
    perl
    qt6-base-dev
    qt6-base-private-dev
    ninja
    "
subpackages="$pkgname-dev $pkgname-libs"
builddir="$srcdir/qttools-everywhere-src-${pkgver/_/-}"
source="https://download.qt.io/official_releases/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qttools-everywhere-src-${pkgver/_/-}.tar.xz"
options="!check" # Tests aren't found

build() {
    # It's qcc here, but compiled with clang on the selfhosted system
    if [[ $CARCH == "x86_64" ]]; then
        _triplet="qnx-x86-64-qcc"
    elif [[ $CARCH == "aarch64" ]]; then
        _triplet="qnx-aarch64le-qcc"
    else
        die "$CARCH not supported"
    fi

    _warn="-Wno-character-conversion"

    export CC=clang
    export CXX=clang++
    export CFLAGS="$_warn"
    export CXXFLAGS="$_warn"
    export LDFLAGS="-lsocket"
    export LD_LIBRARY_PATH="$builddir/build/lib:$LD_LIBRARY_PATH"

    cmake -B build -G Ninja \
        -DCMAKE_SKIP_RPATH=ON \
        -DQT_QMAKE_TARGET_MKSPEC=$_triplet \
        -DQT_INSTALL_XDG_DESKTOP_ENTRIES=ON \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
        -DFEATURE_pkg_config=ON

    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    cd "$pkgdir"
    mkdir -p usr/bin
    while read -r _line; do
        ln -s $_line
    done < "$builddir"/build/user_facing_tool_links.txt
}

dev() {
    default_dev

    amove usr/lib/qt6/sbom
}

libs() {
    default_libs
    depends="
        libc++
        qt6-base
        zstd-libs
        qnx-egl
        qnx-gles
        qnx-io-sock
        "
}

sha512sums="
